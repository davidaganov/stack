{
  "name": "@davidaganov/stack",
  "version": "1.0.0",
  "description": "Interactive CLI to create modern web projects (Vue, Lynx, Astro)",
  "type": "module",
  "bin": {
    "stack": "index.js"
  },
  "files": [
    "index.js",
    "src/",
    "scripts/",
    "README.md",
    "GUIDLINE.md",
    "LICENSE"
  ],
  "keywords": [
    "build-tool",
    "cli",
    "web",
    "vue",
    "astro",
    "pwa",
    "template",
    "starter"
  ],
  "homepage": "https://github.com/davidaganov/stack#readme",
  "bugs": {
    "url": "https://github.com/davidaganov/stack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidaganov/stack.git"
  },
  "author": {
    "name": "David Aganov",
    "url": "https://github.com/davidaganov"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "help": "node scripts/print-help.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "parity": "node scripts/webstack-parity.mjs",
    "gen:all": "node scripts/generate-fixtures.mjs --all",
    "gen:pwa": "node scripts/generate-fixtures.mjs --template vue-pwa-template",
    "gen:lynx": "node scripts/generate-fixtures.mjs --template vue-lynx-template",
    "gen:astro": "node scripts/generate-fixtures.mjs --template astro-clean-template"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "kolorist": "^1.8.0",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3"
  }
}
